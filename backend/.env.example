# The model size used by local transcription (both engines).
# tiny, base, small, medium, large-v3. Larger = more accurate but slower.
WHISPER_MODEL_SIZE=medium

# Transcription provider: faster_whisper (default), whisper, youtube_captions,
# or assemblyai (paid).
# - faster_whisper: local CTranslate2 Whisper, no API key, word-level timestamps
# - whisper: local openai-whisper, no API key, word-level timestamps
# - youtube_captions: extract from YouTube captions (YouTube-sourced only)
# - assemblyai: cloud API, best accuracy with speaker diarization (paid)
TRANSCRIPTION_PROVIDER=faster_whisper
# Optional AssemblyAI model override across every processing mode.
# universal-2 retains word timings and speaker diarization at lower cost.
ASSEMBLY_AI_SPEECH_MODEL=

# Processing mode: free (default), premium, local or custom.
AI_PROVIDER_MODE=free
AI_ALLOW_PAID_PROVIDERS=false
AI_FREE_FALLBACK_ENABLED=true

# Agnes AI - free reasoning provider (https://platform.agnes-ai.com)
AGNES_API_KEY=
AGNES_MODEL=
AGNES_BASE_URL=
AGNES_TIMEOUT_SECONDS=600

# LLM Providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
YOUTUBE_DATA_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional. Defaults to http://localhost:11434/v1 for local backend runs,
# or http://host.docker.internal:11434/v1 inside Docker.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
# Used by local mode and as the free fallback when Agnes is out of quota.
OLLAMA_MODEL=

# The AI Model to use throughout the app. Free mode resolves this to
# agnes:AGNES_MODEL; premium/custom mode uses it verbatim.
LLM=agnes:agnes-2.5-flash

# Optional editor-only model; default is claude-sonnet-5-5.
# AI_EDIT_MODEL=ollama:qwen3.8:27b
# AI_EDIT_DAILY_LIMIT=150

# Prevent tasks from sitting in queued forever if worker is down
QUEUED_TASK_TIMEOUT_SECONDS=180

# YouTube metadata lookup provider: `yt_dlp` or `youtube_data_api`
YOUTUBE_METADATA_PROVIDER=yt_dlp
# Task-creation YouTube length check, in seconds (default 30, cap 180).
YOUTUBE_PREFLIGHT_TIMEOUT_SECONDS=30

# Processing defaults
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=nano

# Good for speed optimizations
COMPOSE_BAKE=true

# DB
POSTGRES_DB=supoclip
POSTGRES_USER=supoclip
POSTGRES_PASSWORD=supoclip_password

ASSEMBLY_AI_API_KEY=

# Discord webhook URLs (each posts to a separate channel)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# Monetization (only enabled when SELF_HOST=false)
SELF_HOST=true
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
APP_SETTINGS_ENCRYPTION_KEY=change_me_settings_encryption_secret
ALLOW_UNSIGNED_BACKEND_AUTH=false
AUTH_SIGNATURE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://sp.localhost:3000,http://supoclip.localhost:3000
# Hosted mode requires a paid subscription. Monthly allowance in minutes of
# source video (0 = unlimited).
PRO_PLAN_MINUTE_LIMIT=600
SCALE_PLAN_MINUTE_LIMIT=1500

# Durable media: local for self-hosting, s3 for private object storage.
# IAM roles/default AWS credentials work when dedicated media keys are blank.
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_PREFIX=media
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
# Optional independent S3-compatible mirror (for example Cloudflare R2).
# Enable failover only after existing media has been copied and verified.
MEDIA_FALLBACK_BUCKET=
MEDIA_FALLBACK_ENDPOINT=
MEDIA_FALLBACK_REGION=auto
MEDIA_FALLBACK_ACCESS_KEY_ID=
MEDIA_FALLBACK_SECRET_ACCESS_KEY=
MEDIA_FAILOVER_ENABLED=false
MEDIA_URL_TTL_SECONDS=900
MEDIA_CACHE_TTL_SECONDS=86400
MEDIA_ORPHAN_GRACE_SECONDS=86400
MEDIA_UPLOAD_CONCURRENCY=3
MEDIA_UPLOAD_DAILY_LIMIT=20
